<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>IRONCORE @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
    </choices-outline>
    <choice id="vst3" title="IRONCORE VST3" description="VST3-Plugin fuer Ableton Live, Bitwig, Reason, Cubase, FL Studio u.a.">
        <pkg-ref id="de.frequenzbetrieb.ironcore.vst3"/>
    </choice>
    <choice id="au" title="IRONCORE Audio Unit" description="AU-Plugin fuer Logic Pro, GarageBand, MainStage">
        <pkg-ref id="de.frequenzbetrieb.ironcore.au"/>
    </choice>
    <pkg-ref id="de.frequenzbetrieb.ironcore.vst3" version="@VERSION@">IRONCORE-VST3.pkg</pkg-ref>
    <pkg-ref id="de.frequenzbetrieb.ironcore.au" version="@VERSION@">IRONCORE-AU.pkg</pkg-ref>
</installer-gui-script>
